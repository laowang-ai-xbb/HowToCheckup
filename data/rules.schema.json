{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "体检项目指南 · 规则结构定义",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "rules"],
  "topics": [
    "baseline",
    "cancer-colorectal",
    "cancer-lung",
    "cancer-stomach",
    "cancer-breast",
    "cancer-cervix",
    "cancer-liver",
    "cancer-prostate",
    "cancer-other",
    "cardiovascular",
    "thyroid",
    "bone",
    "infection-hp",
    "infection-hepatitis",
    "tumor-markers",
    "advanced-imaging",
    "pregnancy"
  ],
  "topicsNote": "主题标签是'项目页/病页'的索引键，也是二期内容组织的骨架。新增标签必须先登记在这里，否则校验器报错——防止页面分组悄悄散架。",
  "properties": {
    "schemaVersion": { "type": "string" },
    "updatedAt": { "type": "string" },
    "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["org", "year", "point", "url", "status", "grade"],
      "properties": {
        "org": { "type": "string" },
        "year": { "type": "string" },
        "point": { "type": "string" },
        "url": { "type": "string" },
        "status": { "enum": ["verified", "pending", "stale"] },
        "grade": { "type": "string", "description": "推荐强度/证据等级，如 USPSTF-D、GRADE-强、IA" },
        "checkedAt": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "name", "category", "catalogIds", "topics", "when", "verdict", "reason", "whatItFinds", "frequency", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string" },
        "displayName": { "type": "string", "description": "对外展示短名：去掉括号里的解释，卡片标题/分享文字/分享图/打印稿统一用它" },
        "category": { "enum": ["A", "B", "C"] },
        "catalogIds": { "type": "array", "items": { "type": "string" }, "minItems": 0 },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "主题标签，取值必须来自顶层 topics 枚举。用于项目页/病页分组与内链。"
        },
        "when": {
          "type": "object",
          "properties": {
            "ageMin": { "type": "number" },
            "ageMax": { "type": "number" },
            "gender": { "enum": ["male", "female"] },
            "any": { "type": "array" },
            "all": { "type": "array" },
            "none": { "type": "array" }
          },
          "additionalProperties": true
        },
        "verdict": { "type": "string" },
        "reason": { "type": "string" },
        "whatItFinds": { "type": "string", "description": "能发现什么/不能发现什么，一句大白话" },
        "frequency": {
          "type": "object",
          "required": ["type", "text"],
          "properties": {
            "type": { "enum": ["once", "interval"] },
            "text": { "type": "string" },
            "years": { "type": "number" }
          }
        },
        "skipIfDoneWithin": { "type": "number", "description": "若 N 年内做过且结果正常，本次可跳过" },
        "priority": { "type": "number", "description": "A 档内部排序，数字越小越优先" },
        "redFlags": { "type": "array", "items": { "type": "string" } },
        "tellDoctor": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" }, "minItems": 1 }
      }
    }
  }
}
